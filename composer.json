{
    "name": "vusys/zefram",
    "description": "Skip PHPUnit tests whose executed code hasn't changed since they last passed. Faster than light.",
    "license": "MIT",
    "type": "library",
    "keywords": ["phpunit", "testing", "test-skipping", "coverage", "ci"],
    "require": {
        "php": "^8.2",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
        "ext-pcov": "Required to capture per-test coverage; without it Zefram disables itself and all tests run."
    },
    "autoload": {
        "psr-4": {
            "Vusys\\Zefram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vusys\\Zefram\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/zefram"
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:e2e": "phpunit --testsuite e2e"
    },
    "require-dev": {
        "brianium/paratest": "^7.20"
    }
}
